{
  "expo": {
    "name": "TLALCANI",
    "slug": "suelo-inteligente",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tlalcani-icon.png",
    "scheme": "suelointeligente",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/tlalcani-icon.png"
    },
    "android": {
      "package": "com.vediv.suelointeligente",
      "adaptiveIcon": {
        "backgroundColor": "#101712",
        "foregroundImage": "./assets/images/tlalcani-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tlalcani-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDF2EE",
          "image": "./assets/images/tlalcani-logo.png",
          "imageWidth": 210,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#101712",
            "image": "./assets/images/tlalcani-logo.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "555069a6-eb21-451c-bb28-860086ff8945"
      }
    }
  }
}
